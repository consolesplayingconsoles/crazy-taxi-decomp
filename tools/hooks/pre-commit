#!/usr/bin/env bash
# Keeps the README's Progress block current: on every commit it rewrites the lines between
# <!-- progress --> and <!-- /progress --> with tools/progress.py's report, and stages README.md and the badges/ directory.
# Enable once per clone: git config core.hooksPath tools/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# A commit must build: build.sh compiles and links every source and has to print MATCH (a compile error shows up there too).
# Needs Docker. SKIP_BUILD_CHECK=1 skips it. The staged sources are not proven again here: each function was proven when its C was
# written (tools/equiv.py records it in tests/equivalent.txt), and re-running the check on every staged file took about a minute
# a file (Virtua Tennis, 297 files: about five hours for one commit).
if [ "${SKIP_BUILD_CHECK:-}" != "1" ] && [ -f build.sh ]; then
    echo "[pre-commit] build.sh: compile and link every source..." >&2
    out="$(bash build.sh 2>&1)" || true
    case "$out" in
        *"MATCH: "*) ;;
        *) printf '%s\n' "$out" | tail -25 >&2
           echo "[pre-commit] build.sh did not print MATCH: commit refused (SKIP_BUILD_CHECK=1 skips the check)" >&2
           exit 1;;
    esac
    if [ -f tools/8-build/retcheck.py ] && ! python3 tools/8-build/retcheck.py >/dev/null 2>&1; then
        python3 tools/8-build/retcheck.py >&2 || true
        echo "[pre-commit] commit refused: a function's C returns in the other register than the original (tools/8-build/retcheck.py)" >&2
        exit 1
    fi
    if [ -f tools/equiv.py ]; then
        if [ -f tools/5-generated/audit_equivalent.py ] && ! python3 tools/5-generated/audit_equivalent.py >/dev/null 2>&1; then
            python3 tools/5-generated/audit_equivalent.py >&2 || true
            echo "[pre-commit] commit refused: tests/equivalent.txt names functions with no C behind them (python3 tools/5-generated/audit_equivalent.py --fix removes them)" >&2
            exit 1
        fi
        git add tests/equivalent.txt docs/equivalent.md 2>/dev/null || true
    fi
fi
grep -q '<!-- progress -->' README.md || exit 0
[ -f functions.txt ] || exit 0
report="$(python3 tools/progress.py 2>/dev/null)" || { echo "[pre-commit] tools/progress.py failed: Progress block left as is" >&2; exit 0; }
python3 - "$report" <<'PY'
import re, sys
s = open("README.md", encoding="utf-8").read()
block = "<!-- progress -->\n```\n%s\n```\n<!-- /progress -->" % sys.argv[1].rstrip()
s2 = re.sub(r"<!-- progress -->.*?<!-- /progress -->", lambda m: block, s, flags=re.S)
if s2 != s:
    open("README.md", "w", encoding="utf-8").write(s2)
PY
git add README.md
git add badges 2>/dev/null || true
[ -f badge.svg ] && git rm -q --cached badge.svg 2>/dev/null; true
