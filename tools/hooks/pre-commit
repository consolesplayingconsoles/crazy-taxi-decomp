#!/usr/bin/env bash
# Rewrites the progress block in README.md from tools/progress.py and stages it.
# Enable once per clone: git config core.hooksPath tools/hooks
set -e
cd "$(git rev-parse --show-toplevel)"
python3 tools/progress.py > /tmp/ct-progress.$$ || { rm -f /tmp/ct-progress.$$; exit 1; }
python3 - /tmp/ct-progress.$$ <<'P'
import sys
start, end = '<!-- progress:start -->', '<!-- progress:end -->'
r = open('README.md').read()
a, b = r.index(start) + len(start), r.index(end)
new = r[:a] + '\n```\n' + open(sys.argv[1]).read().rstrip() + '\n```\n' + r[b:]
if new != r:
    open('README.md', 'w').write(new)
P
rm -f /tmp/ct-progress.$$
git add README.md
