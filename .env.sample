# The decomp's .env: copy this file to .env and set each value. No real data here.

# the Katana SDK folder (setup.sh, build.sh, tools/sim/equiv.py)
SDK_PATH="/path/to/katana-sdk"
# your original disc (.gdi): the Dreamcast build writes a copy of it with the rebuilt game; the native program is named after it
GDI="/path/to/Crazy Taxi (Europe) (En,Ja).gdi"
# the native port's build container (port/Dockerfile, port/README.md)
PORT_IMAGE=crazy-taxi-port
# the native port's picture: 1 widescreen (16:9, the game's view wider, menus 4:3 in the middle, HUD at the sides), 0 the console's 4:3
PORT_WIDESCREEN=1
# the ssh host of the machine that plays the native port (a name from ~/.ssh/config, or user@address): state/send.sh
PORT_HOST=localhost
# the folder on that machine the program and its data files go to: state/send.sh
PORT_DIR=/path/on/that/machine
