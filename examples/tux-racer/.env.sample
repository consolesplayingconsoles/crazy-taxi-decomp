# Folder holding your disc's .gdi (and its track files)
ORIGINAL_GDI_DIR="/path/to/your disc folder"
# A Python 3 with numpy and Pillow
PYTHON="/path/to/python3"
# Your Katana SDK
SDK_PATH="/path/to/katana-sdk"
# How many copies of the course are joined end to end (1 to 3)
TUX_COPIES=3
# Customers waiting on every kilometre of the course (at least 1 in all, at most 246)
TUX_FARES_PER_KM=8
# The shortest trip a customer asks for, in metres (at most 40% of the course)
TUX_MIN_TRIP_M=250
