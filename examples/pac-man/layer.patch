@@ -15,6 +15,304 @@ typedef struct { float radius; NLpoint3 pos; float pad; } CoursePiece;
 #define SUBWAY_CAMERA   (*(int *)0x0C2A9D60)
 #define AREA_LIST       (*(unsigned char **)0x0C2A6EC4)
 
+/* OSM (osm layer): Arcade's city is replaced by a place from OpenStreetMap. tools/osm_coldc.py and tools/osm_model.py write the ground, the
+   buildings' walls and the model into COLDC1.BIN (read at 0x0CB40000 and kept) and osm.h (where the model is, where the cab starts, the
+   name on the menu). The city's pieces are not drawn in Arcade (putSplinePiece), the model is (osmDraw, in PutCourse), the textures go into
+   free slots at a run's start (osmStart, gameState0, before init_CarMain: the game frees every texture when the city loads). */
+#include "osm.h"
+
+#include "course_kit.h"                                 /* course-kit layer: the blob's textures, the stops, the customers */
+
+extern void nlPushMatrix(int n);
+extern void nlPopMatrix(int n);
+extern void nlObjPutUseViewMatrix(void *model);
+
+/* The blob (tools/osm_model.py, the Doom layout): +4 texture count, +8 the tile list, +12 the texture table, +16 the first texture number,
+   +20 the tile count, +24 the places for customers (their offset, how many: x, y, z each, reachable on the roads). */
+#define OSM_DRAW_RANGE  3000.0f                         /* tiles (1024 units) farther than this from the camera are not sent to the video buffer */
+#define OSM_FARE_TRIES  64                              /* the random places a fare's pick-up is chosen among (the farthest from the others) */
+
+/* The stops (where the customers wait and where they want to go): Arcade's 33 are polygons in the executable at the city's coordinates. Each
+   run they are put at random places of the roads (the blob's list), a regular polygon of OSM_STOP_R on the ground there, before init_KyakuMain
+   reads them. The tables: per Game_No a table per MiniGame_No, of the stops (8 bytes: points, pointer). The customers are Arcade's 246
+   requests (kyakuStops0 at 0C0DB008, 0x28 bytes each, a pick-up spot at +8, +0xC, +0x10): OSM_FARES of them are put on the roads, each at the
+   farthest of OSM_FARE_TRIES places from the ones placed, the rest are sent far away, where no customer ever comes within reach. */
+static void osmStops(unsigned int *o)
+{
+    int game = *(int *)0x0C1EE210, mg = *(int *)0x0C1EE214;
+    int count = *(int *)(*(int *)(0x0C0ED9D4 + 4 * game) + 4 * mg);
+    int *list = (int *)*(int *)(*(int *)(0x0C0ED974 + 4 * game) + 4 * mg);
+    int *dlist = (int *)*(int *)(*(int *)(0x0C0ED9C8 + 4 * game) + 4 * mg);
+    /* the frame counter is the same number at every run's start; the SH-4's timer unit (TMU0's counter) keeps counting whatever the game does */
+    unsigned int seed = ((unsigned int)*(int *)0x0C1EE330 ^ *(volatile unsigned int *)0xFFD8000C) * 2654435761u + 12345u;
+    float *sp = (float *)((unsigned char *)o + o[6]);
+    int n = (int)o[7];
+    float sx[33], sz[33], fx[64], fz[64];
+    float cx, cz, tx, tz, d, closest, best;
+    int i, k, t, tries;
+
+    if (count <= 0 || count > 33 || !list || n <= 0)
+        return;
+    for (i = 0; i < count; i++) {
+        t = (int)(ctRand(&seed) % (unsigned int)n);
+        sx[i] = sp[3 * t];
+        sz[i] = sp[3 * t + 2];
+        ctPlaceStop(list, dlist, i, sx[i], sz[i], ctGround(sx[i], sz[i], 0.0f), OSM_STOP_R);
+    }
+    for (i = 0; i < 246; i++) {
+        float *e = (float *)(0x0C0DB008 + 0x28 * i);
+        signed char *dest = (signed char *)(0x0C0DB008 + 0x28 * i + 0x18);
+
+        if (i >= OSM_FARES) {
+            e[2] = 1.0e6f;
+            e[3] = 0.0f;
+            e[4] = 1.0e6f;
+            continue;
+        }
+        best = -1.0f;
+        cx = sp[0];
+        cz = sp[2];
+        for (tries = 0; tries < OSM_FARE_TRIES; tries++) {
+            t = (int)(ctRand(&seed) % (unsigned int)n);
+            tx = sp[3 * t];
+            tz = sp[3 * t + 2];
+            closest = 1.0e12f;
+            for (k = 0; k < i && k < 64; k++) {
+                d = (tx - fx[k]) * (tx - fx[k]) + (tz - fz[k]) * (tz - fz[k]);
+                if (d < closest)
+                    closest = d;
+            }
+            if (closest > best) {
+                best = closest;
+                cx = tx;
+                cz = tz;
+            }
+        }
+        if (i < 64) {
+            fx[i] = cx;
+            fz[i] = cz;
+        }
+        e[2] = cx;
+        e[3] = ctGround(cx, cz, 0.0f);
+        e[4] = cz;
+        ctDestinations(e, dest, cx, cz, sx, sz, count, OSM_MIN_TRIP, &seed);
+    }
+}
+
+/* Pac-Man as the cab's driver (pacman_coldc.py): the blob has a tile listed at 1.0e7, which osmDraw never draws: his sphere and eyes, in the
+   torso bone's axes (the mouth along the chest's front, the top up the spine, a little above the bone). A character is 16 part-model pointers (the table at 0x0C1331B0, a pointer to an entry a character; slot 0
+   unused, a null slot is not drawn, slot 8 is the torso's). Character 0 is no pedestrian, customer or cabbie, its entry (0x0C132330) is its own
+   (no other character points to it) and humanDraw's and FcvPlayBuffer's switches give it no extra parts: its entry is rewritten in place (no
+   static data: the executable's data must not move) to the torso slot alone, Pac-Man's model, and slot 0 marks it done; its grips (the game puts them
+   in parts 2 and 5 while driving, from the table at 0x0C1337CC, one array a character, this one shared with the pedestrians) become OSM_ZEROS. Drv_Put draws the driver
+   as character 0 (osmDriver). The driver's motion moves him with the torso. */
+#define OSM_MAN_MARK    0x4E4D4150
+
+int osmDriver(int c)
+{
+    int *e = (int *)*(int *)0x0C1331B0;
+
+    return (*(int *)0x0C1EE20C == 0 && e[0] == OSM_MAN_MARK) ? 0 : c;
+}
+
+/* The ghosts (the passengers): the blob's solo tiles 1 to 4 are a ghost each (pacman_coldc.py). Characters 24, 26, 28 and 33 have an entry of their
+   own and no extra models in the draw switches (23 to 58 are the customers': 36 characters, most with hats, bags or sleeves that would draw over a
+   ghost), so those four are rewritten in place as Pac-Man's is (the torso slot alone) and Psg_Init gives every customer one of them (osmGhost: its
+   character number's low two bits pick the colour). */
+static int osmGhostChar(int i)
+{
+    switch (i & 3) {
+    case 0:
+        return 24;
+    case 1:
+        return 26;
+    case 2:
+        return 28;
+    default:
+        return 33;
+    }
+}
+
+int osmGhost(int chara)
+{
+    int *e = (int *)*(int *)(0x0C1331B0 + 4 * 24);
+
+    return (*(int *)0x0C1EE20C == 0 && e[0] == OSM_MAN_MARK) ? osmGhostChar(chara) : chara;
+}
+
+static void osmMan(unsigned int *o)
+{
+    int k, i, g, *e;
+
+    for (k = 0; k < (int)o[5]; k++) {
+        unsigned int *t = TILE(o, k);
+
+        if (*(float *)&t[1] <= 1.0e6f)
+            continue;
+        g = (int)(*(float *)&t[1] - 1.0e7f + 0.5f);     /* the group: 0 Pac-Man, 1 to 4 the ghosts, 5 to 8 their far models */
+        if (g < 0 || g > 8)
+            continue;
+        if (g > 4) {                                    /* psgFrameState0's flat model beyond PsgPeraDistance (a table, a character - 23) */
+            ((int *)0x0C13F410)[osmGhostChar(g - 5) - 23] = (int)((unsigned char *)o + t[0]);
+            continue;
+        }
+        e = (int *)*(int *)(0x0C1331B0 + 4 * (g == 0 ? 0 : osmGhostChar(g - 1)));
+        for (i = 1; i < 16; i++)
+            e[i] = 0;
+        e[8] = (int)((unsigned char *)o + t[0]);
+        e[0] = OSM_MAN_MARK;
+        if (g == 0)
+            ((unsigned int *)0x0C1337CC)[0] = OSM_ZEROS;     /* his grips: none (the game's array is the pedestrians' too) */
+        else
+            ((unsigned int *)0x0C1337CC)[osmGhostChar(g - 1)] = OSM_ZEROS;   /* a ghost's: psgUpdatePartTracks put hands in its parts 2 and 5 */
+    }
+}
+
+/* The regular camera's eye (gen_el.c, after its GetCollision, which pulls the eye in front of the course's triangles and knows nothing of our
+   walls): the segment from the target t to the eye e against the maze's wall segments (the blob's list), where the ray is still lower than the
+   walls' top; the eye is brought in to OSM_CAM_MARGIN short of the first one. */
+#define OSM_CAM_MARGIN  5.0f
+void osmCamClip(float *t, float *e)
+{
+    unsigned int *w = (unsigned int *)OSM_CAMWALLS;
+    float *s = (float *)(w + 1);
+    float dx = e[0] - t[0], dz = e[2] - t[2], best = 1.0f, den, a, b, len;
+    unsigned int i;
+
+    if (*(int *)0x0C1EE20C != 0)
+        return;
+    for (i = 0; i < w[0]; i++, s += 4) {
+        float ex = s[2] - s[0], ez = s[3] - s[1];
+
+        den = dx * ez - dz * ex;
+        if (den > -1.0e-6f && den < 1.0e-6f)
+            continue;
+        a = ((s[0] - t[0]) * ez - (s[1] - t[2]) * ex) / den;
+        b = ((s[0] - t[0]) * dz - (s[1] - t[2]) * dx) / den;
+        if (a <= 0.0f || a >= best || b < 0.0f || b > 1.0f)
+            continue;
+        if (t[1] + (e[1] - t[1]) * a > OSM_WALL_TOP)
+            continue;
+        best = a;
+    }
+    if (best < 1.0f) {
+        len = _builtin_sqrtf(dx * dx + dz * dz);
+        if (len > 1.0f)
+            best -= OSM_CAM_MARGIN / len;
+        if (best < 0.05f)
+            best = 0.05f;
+        e[0] = t[0] + dx * best;
+        e[1] = t[1] + (e[1] - t[1]) * best;
+        e[2] = t[2] + dz * best;
+    }
+}
+
+/* gameState0, before init_CarMain: the blob's textures into the game's slots (ctLoadTiles), then the stops and the driver's model. */
+void osmStart(void)
+{
+    unsigned int *o = (unsigned int *)OSM_MODEL;
+
+    if (*(int *)0x0C1EE20C != 0 || o[0] != TUX_MAGIC)
+        return;
+    ctLoadTiles(o);
+    osmStops(o);
+    osmMan(o);
+}
+
+void camSetMode(int m);
+
+/* gameState0, after the start camera is set up: the camera looks down. The game's own view mode 3 (the camera function's: 78.75 degrees
+   down, 600 units from the point 120 ahead of the cab, field of view 60, turning with the cab; the distance is at least 300) is taken. */
+void osmView(void)
+{
+    if (*(int *)0x0C1EE20C != 0 || ((unsigned int *)OSM_MODEL)[0] != TUX_MAGIC)
+        return;
+    camSetMode(3);
+}
+
+void camSnapToCar(int n);
+
+/* The views Y steps through: the game's regular camera (mode 0), then the top view (mode 3) tilted, then the top view steeper. The two top views
+   are the same mode, told apart by the pitch and the distance gen_el.c's mode 3 reads from osmTopPitch and osmTopDist (16-bit angle, units). */
+typedef struct { int mode, pitch; float dist; } OsmView;
+#define OSM_VIEWS       3
+static const OsmView osmViews[OSM_VIEWS] = { { 0, 0, 0.0f }, { 3, 0xE000, 1000.0f }, { 3, 0xCC00, 600.0f } };
+int osmTopPitch = 0xE000;                               /* 45 degrees down */
+float osmTopDist = 1000.0f;
+static int osmViewNo;
+
+/* The side tunnel (osm.h's OSM_WRAP_*, pacman_coldc.py): a cab in the tunnel's row (OSM_WRAP_Z, half OSM_WRAP_HALF) that goes past the left edge comes in
+   at the right one, and the other way, keeping its speed: Car_Data's position (0x0C179144, x y z) and the copy of it the game keeps next to it
+   (0x0C179158, set from the position at a start) move together by the maze's width, so nothing sees the cab cross the maze in one step. */
+static void osmWrap(void)
+{
+    float *p = (float *)0x0C179144, *q = (float *)0x0C179158;
+    float d;
+
+    if (*(int *)0x0C1EE234 != 1 || *(int *)0x0C1EE238 != 1)
+        return;
+    if (p[2] < OSM_WRAP_Z - OSM_WRAP_HALF || p[2] > OSM_WRAP_Z + OSM_WRAP_HALF)
+        return;
+    if (p[0] < OSM_WRAP_X0)
+        d = OSM_WRAP_X1 - OSM_WRAP_X0;
+    else if (p[0] > OSM_WRAP_X1)
+        d = OSM_WRAP_X0 - OSM_WRAP_X1;
+    else
+        return;
+    p[0] += d;
+    q[0] += d;
+    camSnapToCar(0);
+}
+
+/* getSwitch, right after player 1's pad is converted: Y (the byte at 0x0C1EE26E, "pressed this frame", which the horn's three readers take)
+   steps the camera round the views above in a circle instead. The press is cleared so the horn does not sound. Only while an Arcade run is played
+   (main mode 1, sub mode 1). Any camera mode but the top view counts as the regular one: the next press is the tilted top view. */
+void osmPad(void)
+{
+    const OsmView *v;
+
+    if (*(int *)0x0C1EE20C != 0 || ((unsigned int *)OSM_MODEL)[0] != TUX_MAGIC)
+        return;
+    osmWrap();
+    if (*(int *)0x0C1EE234 != 1 || *(int *)0x0C1EE238 != 1 || *(signed char *)0x0C1EE26E == 0)
+        return;
+    *(signed char *)0x0C1EE26E = 0;
+    if (*(int *)0x0C179860 != 3)
+        osmViewNo = 0;
+    osmViewNo = (osmViewNo + 1) % OSM_VIEWS;
+    v = &osmViews[osmViewNo];
+    if (v->mode == 3) {
+        osmTopPitch = v->pitch;
+        osmTopDist = v->dist;
+    }
+    camSetMode(v->mode);
+    *(int *)0x0C0E4A14 = 1;                             /* the mode's set-up runs again: the two top views are one mode */
+    camSnapToCar(0);
+}
+
+/* The model: the tiles near the camera, each its own model, at the camera's view matrix (the world's own coordinates). */
+static void osmDraw(void)
+{
+    unsigned int *o = (unsigned int *)OSM_MODEL;
+    float *cam = (float *)CAM_POS;
+    float dx, dz;
+    int k;
+
+    if (o[0] != TUX_MAGIC)
+        return;
+    for (k = 0; k < (int)o[5]; k++) {
+        unsigned int *t = TILE(o, k);
+
+        dx = *(float *)&t[1] - cam[0];
+        dz = *(float *)&t[2] - cam[2];
+        if (dx * dx + dz * dz > OSM_DRAW_RANGE * OSM_DRAW_RANGE)
+            continue;
+        nlPushMatrix(0);
+        nlObjPutUseViewMatrix((unsigned char *)o + t[0]);
+        nlPopMatrix(1);
+    }
+}
