# Folder holding your disc's .gdi (and its track files)
ORIGINAL_GDI_DIR="/path/to/your disc folder"
# A Python 3 with numpy and Pillow
PYTHON="/path/to/python3"
# Your Katana SDK
SDK_PATH="/path/to/katana-sdk"
# The menu's text for the maze (1 to 31 ASCII characters)
PACMAN_NAME="Pac-Man"
# Customers waiting in the maze (1 to 246)
PACMAN_FARES=12
# The shortest trip a customer asks for, in metres
PACMAN_MIN_TRIP_M=80
# The corridors' width in metres (the maze is scaled so its corridors are this wide)
PACMAN_CORRIDOR_M=7
# The walls' height in metres
PACMAN_WALL_M=3
