+/* Doom Map (doom layer): Original's city is replaced by Doom's map. tools/doom_coldc.py and tools/doom_model.py write the ground, the walls and
+   the model into COLDC2.BIN (read at 0x0CB40000 and kept) and doom.h (where the model is, where the cab starts). The map is drawn in PutCourse
+   (doomDraw), the textures go into free slots at a run's start (doomStart, gameState0, before init_CarMain). */
+#include "doom.h"
+
+#include "course_kit.h"                                 /* course-kit layer: the blob's textures, the stops, the customers */
+
+extern void nlPushMatrix(int n);
+extern void nlPopMatrix(int n);
+extern void nlObjPutUseViewMatrix(void *model);
+int nlTranslateV(int);
