+
+/* The stops (where the customers wait and where they want to go): Arcade's 33 are polygons in the executable at the city's coordinates, and
+   a pick-up needs the cab within the stop's circle, nearly stopped, at a height within 50 of the stop's: at the city's altitudes the slope
+   never matched. Each run they are put at places of Doom's map, one in each of 33 bands, a regular octagon on the ground there, before init_KyakuMain reads them; the game picks the pick-up and the
+   destination among them as it always did. The tables: per Game_No a table per MiniGame_No, of the stops (8 bytes: points, pointer). */
+
+/* A place in the model's blob (o[6] the offset, o[7] how many: x, y, z each, tools/doom_coldc.py reachable_spots): floor the cab can reach from
+   the start and that is clear of the walls, not a random point, which could be in a pit, a sealed room or against a wall, where nobody could
+   pick a customer up. */
+static void doomPlace(unsigned int *seed, float *cx, float *cz)
+{
+    unsigned int *o = (unsigned int *)DOOM_MODEL;
+    float *sp;
+    int n, t;
+
+    *cx = 0.0f;
+    *cz = 0.0f;
+    if (o[0] == TUX_MAGIC && (int)o[7] > 0) {
+        sp = (float *)((unsigned char *)o + o[6]);
+        n = (int)o[7];
+        t = (int)(ctRand(seed) % (unsigned int)n);
+        *cx = sp[3 * t];
+        *cz = sp[3 * t + 2];
+    }
+}
+
+#define DOOM_FARE_TRIES 64                              /* in Doom's map, the random places a fare's pick-up is chosen among (the farthest from the others) */
+
+static void doomStops(void)
+{
+    int game = *(int *)0x0C1EE210, mg = *(int *)0x0C1EE214;
+    int count = *(int *)(*(int *)(0x0C0ED9D4 + 4 * game) + 4 * mg);
+    int *list = (int *)*(int *)(*(int *)(0x0C0ED974 + 4 * game) + 4 * mg);
+    int *dlist = (int *)*(int *)(*(int *)(0x0C0ED9C8 + 4 * game) + 4 * mg);
+    /* the frame counter is the same number at every run's start (the stops came out in the same places each run); the SH-4's timer unit
+       (TMU0's counter, TCNT0) keeps counting whatever the game does, so it is not */
+    unsigned int seed = ((unsigned int)*(int *)0x0C1EE330 ^ *(volatile unsigned int *)0xFFD8000C) * 2654435761u + 12345u;
+    float sx[33], sz[33], fx[64], fz[64];
+    float cz, cx, cy, tx, tz, d, closest, best;
+    int i, k, tries;
+    /* The request table exec_KyakuMain reads (gen_rm.c): Original's 246 are at 0C0DF608, or at 0C0E1C78 when the stage word (0C17948C, which
+       picks Original's start too) is 1. */
+    unsigned int tab = *(int *)0x0C17948C == 1 ? 0x0C0E1C78u : 0x0C0DF608u;
+
+    if (count <= 0 || count > 33 || !list)
+        return;
+    for (i = 0; i < count; i++) {
+        doomPlace(&seed, &cx, &cz);
+        sx[i] = cx;
+        sz[i] = cz;
+        ctPlaceStop(list, dlist, i, cx, cz, ctGround(cx, cz, 0.0f), DOOM_STOP_R);
+    }
+    /* The customers are not the stops: Original's 246 requests (0x28 bytes each), read by exec_KyakuMain and kyakuInitStops, each carry their own
+       pick-up spot at +8, +0xC and +0x10, in the city's coordinates. DOOM_FARES of them (doom.h) are put in the map, on the ground; the rest are
+       sent far away, where no customer ever comes within reach. Each fare's destinations are at least DOOM_MIN_TRIP away (ctDestinations). */
+    for (i = 0; i < 246; i++) {
+        float *e = (float *)(tab + 0x28 * i);
+        signed char *dest = (signed char *)(tab + 0x28 * i + 0x18);
+
+        if (i >= DOOM_FARES) {
+            e[2] = 1.0e6f;
+            e[3] = 0.0f;
+            e[4] = 1.0e6f;
+            continue;
+        }
+        /* Of DOOM_FARE_TRIES random places, the one farthest from every fare placed (a fixed least distance ran out of room after half the fares,
+           and the rest landed where the last try fell: in groups) */
+        best = -1.0f;
+        for (tries = 0; tries < DOOM_FARE_TRIES; tries++) {
+            doomPlace(&seed, &tx, &tz);
+            closest = 1.0e12f;
+            for (k = 0; k < i && k < 64; k++) {
+                d = (tx - fx[k]) * (tx - fx[k]) + (tz - fz[k]) * (tz - fz[k]);
+                if (d < closest)
+                    closest = d;
+            }
+            if (closest > best) {
+                best = closest;
+                cx = tx;
+                cz = tz;
+            }
+        }
+        if (i < 64) {
+            fx[i] = cx;
+            fz[i] = cz;
+        }
+        cy = ctGround(cx, cz, 0.0f);
+        e[2] = cx;
+        e[3] = cy;
+        e[4] = cz;
+        ctDestinations(e, dest, cx, cz, sx, sz, count, DOOM_MIN_TRIP, &seed);
+    }
+}
+
+/* gameState0, before init_CarMain: Doom's map as CourseMode 1 (the menu's DOOM): the blob of tools/doom_model.py (a tile holds several records,
+   one for each texture and light level), at DOOM_MODEL in COLDC2.BIN: its textures into the game's slots (ctLoadTiles), then the stops. */
+void doomStart(void)
+{
+    unsigned int *o = (unsigned int *)DOOM_MODEL;
+
+    if (*(int *)0x0C1EE20C != 1 || o[0] != TUX_MAGIC)
+        return;
+    o[13] = 0;                                          /* doomKeepIn: no place to come back to yet */
+    o[14] = 0;
+    ctLoadTiles(o);
+    doomStops();
+}
+
+#define DOOM_DRAW_RANGE 4000.0f                         /* tiles (1024 units) farther than this from the camera are not sent to the video buffer */
+
+/* Doom's sky (tools/doom_model.py sky_model: SKY1 round a cylinder, the last tile: o[8] tiles are the map's): at the camera, drawn first, so
+   what Doom shows through an outdoor window or over a wall is not black. */
+static void doomSky(void)
+{
+    unsigned int *o = (unsigned int *)DOOM_MODEL;
+
+    nlPushMatrix(0);
+    nlTranslateV(0x0C179840);
+    nlSetScaleFactor(1.0f);
+    nlObjPutUseViewMatrix((unsigned char *)o + TILE(o, o[8])[0]);
+    nlPopMatrix(1);
+    nlSetScaleFactor(2.0f);                             /* what the dome's code leaves it at (the dome's code, PutCourse_Sky, leaves it at 2) */
+}
+
+/* Doom's map is rooms, and the game was made for streets: a ramp or a wall can throw the cab over the walls, out of the map, where the game's
+   own recovery (carGroundCheck) puts it on a course point of the city's, nowhere near. Each frame: a cab on the ground (within 8 of the floor
+   under it) is a place to come back to (o[9]-o[11], its heading o[12], o[14] set); a cab with no floor under it, or under the lowest floor,
+   for DOOM_OUT_FRAMES frames running (o[13]) is put back there, stopped and upright, as the game's recovery does (engine.md, carGroundCheck). */
+#define DOOM_OUT_FRAMES 30
+#define DOOM_CAR ((unsigned char *)0x0C1790CC)
+
+static void doomKeepIn(unsigned int *o)
+{
+    float *pos = (float *)(DOOM_CAR + 0x78);
+    float *keep = (float *)&o[9];
+    float g = ctGround(pos[0], pos[2], 1.0e9f);
+    int k;
+
+    if (g < 1.0e8f && pos[1] > DOOM_FLOOR_MIN - 40.0f) {
+        o[13] = 0;
+        if (pos[1] - g < 8.0f && g - pos[1] < 8.0f) {
+            keep[0] = pos[0];
+            keep[1] = g;
+            keep[2] = pos[2];
+            o[12] = *(unsigned short *)(DOOM_CAR + 0x86);
+            o[14] = 1;
+        }
+        return;
+    }
+    if (o[14] != 1 || ++o[13] < DOOM_OUT_FRAMES)
+        return;
+    o[13] = 0;
+    pos[0] = keep[0];
+    pos[1] = keep[1] + 5.0f;
+    pos[2] = keep[2];
+    for (k = 0; k < 3; k++) {
+        ((float *)(DOOM_CAR + 0x8C))[k] = pos[k];
+        ((float *)(DOOM_CAR + 0xFC))[k] = 0.0f;
+        ((float *)(DOOM_CAR + 0x108))[k] = 0.0f;
+    }
+    *(float *)(DOOM_CAR + 0x15C) = 0.0f;
+    *(float *)(DOOM_CAR + 0x160) = 0.0f;
+    *(unsigned short *)(DOOM_CAR + 0x84) = 0;
+    *(unsigned short *)(DOOM_CAR + 0x86) = (unsigned short)o[12];
+    *(unsigned short *)(DOOM_CAR + 0x88) = 0;
+    *(unsigned short *)(DOOM_CAR + 0xF6) = (unsigned short)o[12];
+}
+
+static void doomDraw(void)
+{
+    unsigned int *o = (unsigned int *)DOOM_MODEL;
+    float *cam = (float *)CAM_POS;
+    float dx, dz;
+    int k;
+
+    doomKeepIn(o);
+    for (k = 0; k < (int)o[8]; k++) {                   /* o[8]: the map's tiles; the sky's follows them */
+        unsigned int *t = TILE(o, k);
+
+        dx = *(float *)&t[1] - cam[0];
+        dz = *(float *)&t[2] - cam[2];
+        if (dx * dx + dz * dz > DOOM_DRAW_RANGE * DOOM_DRAW_RANGE)
+            continue;
+        nlPushMatrix(0);
+        nlObjPutUseViewMatrix((unsigned char *)o + t[0]);
+        nlPopMatrix(1);
+    }
+}
+
+#define DOOM_CAM 1.0f                                   /* the chase camera's offsets (camUpdate, gen_el.c: 15 above and 60 behind the cab) times this, in Doom's map */
+
+/* The scale of the chase camera's eye offsets: Doom's rooms are small for the cab and the camera at its usual distance sat in their walls and
+   showed the cab small; closer, the cab fills more of the view. Called by camUpdate (the layer's gen_el.c hunk), 1 anywhere but Doom's map. */
+float doomCam(void)
+{
+    if (COURSE_MODE == 1 && ((unsigned int *)DOOM_MODEL)[0] == TUX_MAGIC)
+        return DOOM_CAM;
+    return 1.0f;
+}
