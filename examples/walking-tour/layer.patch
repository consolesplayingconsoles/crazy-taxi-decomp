+/* Walking Tour settings: on foot. See README.md here for how they are split. */
+
+/* Controls on foot (PAD_* in game.h). Driving is the game's own. */
+#define BTN_ENTER       PAD_Y           /* step out; at the driver's door step in; beside a car take it */
+#define BTN_JUMP        PAD_A
+#define BTN_HAIL        PAD_X           /* a taxi pulls up in front of you */
+#define BTN_SPRINT      PAD_B           /* held: run */
+#define SPRINTING       (PAD_HELD & BTN_SPRINT)
+#define STICK_DEAD      16              /* stick travel (of 128) ignored around the centre */
+
+/* Timing on foot */
+#define INTRO           300             /* frames after a run starts before BTN_ENTER works (no signal
+                                           for the intro's end yet: a timer, and Ready-Go gone) */
+#define HAIL_TIME       60              /* frames the hand stays up */
+
+/* Walking and running: a customer jog (set off, jog, halt: 121 frames); the game has no walk:
+   played slowly, it is one. Root motion: the stride says how far each frame moves him. */
+#define WALK            ((Motion *)0x0CAB6BBC)
+#define WALK_FIRST      39.0f           /* its steady stride, one cycle */
+#define WALK_LAST       83.0f
+#define HALT_LAST       120.0f          /* 83-120: slowing down to a stop */
+#define HALT_RATE       1.5f            /* clip frames per game frame: halting */
+#define WALK_RATE       1.1f            /* walking */
+#define RUN_RATE        1.8f            /* running (SPRINTING) */
+#define WALK_STRIDE     1.8f            /* ground covered per frame, against the clip's own */
+#define RUN_STRIDE      2.9f
+#define SEAM            16.0f           /* the stride's ends differ: crossfade over its last frames */
+#define TURN_SHIFT      2               /* each frame he turns 1/2^n of the way to the stick */
+#define RUN_TURN_SHIFT  3               /* a sprint turns wide */
+#define BODY            5.0f            /* his radius against walls and cars */
+#define PED_REACH       10.0f           /* his radius against a person's: BODY + 5 */
+#define WALK_MAX        10.0f           /* a move further than this in a frame is a step out or a
+                                           jump across, not a walk (no pushes, no dodging) */
+#define HAIL            ((Motion *)0x0CB17990)   /* a customer holding a hand up for a cab */
+#define STAND_TURN      0x4500          /* the standing pose (and the hail) faces 97 degrees right of his
+                                           stride: turned back to it (the halt eases it in) */
+
+/* Jumping and falling */
+#define JUMP_SPEED      2.2f            /* walk mode: about 1 m high (peak = speed^2 / 2 gravity) */
+#define GRAVITY         0.25f
+#define AIR_RATE        RUN_RATE        /* a jump from standing runs in the air: stride frames per frame */
+#define JUMP_OUT        ((Motion *)0x0CB32654)   /* out of the car at any speed: Crazy Taxi's own Jump Left (MOTDC.BIN
+                                           0x2B2654, 66 frames, its root travels 38.7 along his facing) */
+#define JUMP_OUT_RATE   1.0f            /* its frames per frame */
+#define JUMP_OUT_FIRST  20.0f           /* the frame he appears in: already in the take-off (0 is standing at the door) */
+#define DIVE_SLIDE      0.6f            /* share of the car's speed he carries out with him */
+#define DIVE_FRICTION   0.92f           /* share of the slide kept each frame */
+
+/* The music on foot: this much under the volume chosen in the options (0.1 dB; driving it is the
+   options' own) */
+#define MUSIC_ON_FOOT   (-20.0f)
+#define MUSIC_FADE      2.0f            /* 0.1 dB a frame, in and out (under a second) */
+
+/* The camera on foot (GTA-style follow) */
+#define CAM_DIST        45.0f           /* how far behind */
+#define CAM_HEIGHT      22.0f           /* and how high */
+#define HEAD_HEIGHT     15.0f           /* it looks at his head */
+#define SLOPE_SPAN      30.0f           /* the slope under him: the ground this far ahead and behind */
+#define SLOPE_PROBE     30.0f           /* probed from this far above his feet */
+#define SLOPE_MAX       1.0f            /* the steepest it follows (45 degrees) */
+#define CAM_LOOK        17.0f           /* the look-at rises with the slope over this reach (the game's chase: 17 ahead) */
+#define CAM_PULL        0.5f            /* the eye eases to its goal as the game's chase camera does: */
+#define CAM_KEEP        0.1f            /* this much of the gap a frame, this much of its speed kept */
+#define TARGET_PULL     0.8f            /* and the look-at */
+#define TARGET_KEEP     0.3f
+
+/* A fare on foot */
+#define FARE_BEHIND     14.0f           /* jogs this far behind him */
+#define FARE_CATCH      0.12f           /* closing this share of the gap a frame */
+#define PICKUP_RAISE    3.0f            /* a passenger standing in the pickup's bed, raised to show */
