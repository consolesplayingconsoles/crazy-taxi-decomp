+void modEveryFrame(void)
+{
+    static int frames = 0, menus = 0;
+    unsigned int i;
+
+    if (!menus) {
+        for (i = 0; i < sizeof menuData / sizeof menuData[0]; i++)
+            *(unsigned int *)menuData[i][0] = menuData[i][1];
+        menus = 1;
+    }
+
+    if (DEBUG_QUICK_START && MAIN_MODE != 1 && ++frames >= DEBUG_PRESS_EVERY) {
+        frames = 0;
+        PAD_PRESSED |= PAD_START | PAD_A;
+    }
+    kyakuVr = (out && ridingTask()) ? 0 : VR_MODE;       /* the drop-off zone shows on foot (kyakuTaskExec draws */
+                                                        /* it only in camera modes 0-2) */
+    {                                                   /* the music: on foot MUSIC_ON_FOOT under the */
+        static float drop = 0.0f;                       /* volume chosen in the options, eased in and */
+        float want = out ? MUSIC_ON_FOOT : 0.0f;        /* out; driving the game's own (untouched) */
+        int i, v;
+
+        drop += want > drop ? (want - drop > MUSIC_FADE ? MUSIC_FADE : want - drop)
+                            : (drop - want > MUSIC_FADE ? -MUSIC_FADE : want - drop);
+        if (drop < 0.0f) {                              /* the game's level (gdc_PlayStreamSong's: the option */
+            v = musicLevelDb(MUSIC_LEVEL);              /* scaled into MUSIC_LEVEL, in 0.1 dB), set every */
+            if (MUSIC_LEVEL)                            /* frame (a new track resets it); muted (0: the */
+                v = v + (int)drop < -960 ? -960 : v + (int)drop;   /* game's -999) stays muted */
+            for (i = 0; i < ADX_AFS1_COUNT; i++)
+                if (ADX_AFS1[i])
+                    adxtSetOutVol(ADX_AFS1[i], v);
+        }
+    }
+    checkSoftReset();
+}
