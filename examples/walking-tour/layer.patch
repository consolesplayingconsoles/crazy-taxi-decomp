+/* The driver on foot and the world: set objects (postboxes, signs, crates) fly when he walks into
+   them, people jump out of his way, customers he bumps storm off, and no customer boards a cab he
+   left. All of it copies what the game does for the player car (crazy-taxi-decomp,
+   docs/engine.md: Set objects, Pedestrians, Passengers). */
+#include "game.h"
+#include "config/foot.h"
+#include "config/drive.h"
+#include "config/world.h"
+
+
+extern int out;
+extern float jumpY;
+extern float ped[];
+extern int yaw;
+void carsPush(float *p);
+
+#define POS (&ped[1])
+
+float boardRange = 500.0f;                              /* kyakuTaskExec: a customer boards only nearer the cab than this */
+#define BOARD_RANGE boardRange
+static int inCar = BOARD_WAIT;
+
+#define SETOBJ_GROUPS (*(unsigned char **)0x0C0EDBB8)   /* setObjGroupTbl: 32-byte groups */
+#define SETOBJ_FIRST (*(int *)0x0C2757F0)
+#define SETOBJ_END (*(int *)0x0C2757F4)
+#define COLLI_KINDS ((float *)0x0C0ED440)               /* colliKindTbl: 7 floats a kind, +1 radius, +2 mass */
+#define CAR_HEADING (*(unsigned short *)(TAXI + 0xF4))  /* the heading the crowd's jumps are turned by */
+
+#define JUMP_CLIPS ((Motion **)0x0C0D61AC)              /* the dodge clips; even: to one side (0xC000), odd: the other */
+#define JUMP_DIST ((float *)0x0C12FF24)
+#define SCREAMS ((int *)0x0C12FF7C)
+
+float focus[3] = { 0.0f, 0.0f, 0.0f };                 /* where set objects open around: him on foot, else the car */
+static float last[3] = { 0.0f, 0.0f, 0.0f };
+
+static unsigned int crowdCar[0x1A0 / 4] = { 0 };      /* the stand-in car, 0x1A0 bytes */
+#define CROWD_CAR ((unsigned char *)crowdCar)
+/* Car_Data as the crowd and the passengers read it (crowdSpawn, crowdTask, pedUpdate, the ground-kind helpers
+   pedGetSubwayFlag/pedCarNotInSubway: passers-by spawn ahead of and stay around him; PutCourse and PutCourse_CheckPiece: the
+   Arcade city draws the land listed for the car's nearest course point, +0x60, around the parked cab, the void around him; a
+   passenger's seat matrix, exit side and door, psgSeatMatrix, psgFaceTaxi, psgPickExitSide, psgFrameState4: dropped off on foot,
+   they get out beside him; and pedDodgeCheck: it is handed his distance, pedUpdate's, but put anyone nearer than 25 at 25 from
+   the car itself, the parked cab: sprinting into people sent them there). The layer's C reads it through this: the stand-in
+   on foot, else the car. */
+unsigned char *carView = TAXI;
+#define DRV_PASSENGER (*(unsigned char **)0x0C2AD1D8)    /* the customer in the cab (TaxiDriver + 0x1D8) */
+static float walkSpeed = 0.0f;                          /* his speed last frame: the drop-off waits for him to stop */
+
+/* The customer task riding (phase 2), or 0. */
+unsigned char *ridingTask(void)
+{
+    unsigned char *p = DRV_PASSENGER, *e;
+
+    if (!p)
+        return 0;
+    for (e = EVENT_HEAD; e; e = *(unsigned char **)(e + 0x08))
+        if (e == p - 0x1C)
+            return *(unsigned int *)(e + 0x0C) == CUSTOMER_TASK && *(int *)(e + 0x174) == 2 ? e : 0;
+    return 0;
+}
+#define CAR_SIZE 0x19C                                  /* up to the yaw rate, +0x198, the drop-off reads */
+float getNearLineIndex(int, void *, int, int *, float *);   /* mode 0: search every point */
+#define COURSE_LINE (*(void **)0x0C2A1B28)               /* courseLineTbl: 12-byte points */
+#define COURSE_LINE_COUNT (*(int *)0x0C2A1B2C)
+
+
+/* Passers-by hit by a car fly, as set objects do (SetObjFly: a velocity, gravity, bounces): a car
+   pushing a standing person out of its box (carsPush, to its nearest side) launches them along the
+   push, harder the deeper it got in one frame (about the car's speed); a slow nudge just moves them.
+   Cleared each run. */
+#define FLY 5                                           /* floats a flyer */
+static float flyers[FLYER_MAX * FLY] = { 0 };          /* FLYER_MAX x { person, vx, vy, vz, ground y } */
+#define FLYERS flyers
+
+/* Customers (a tagPASSENGER at their task + 0x1C, position at +4) fly the same way, moved before
+   their task runs (touchBefore): it draws them where they are. FLYER_MAX x { task, vx, vy, vz }. */
+static float custFlyers[FLYER_MAX * 4] = { 0 };
+
+void flyersReset(void)
+{
+    int i;
+
+    for (i = 0; i < FLYER_MAX * FLY; i++)
+        ((int *)FLYERS)[i] = 0;
+    for (i = 0; i < FLYER_MAX * 4; i++)
+        ((int *)custFlyers)[i] = 0;
+}
+
+/* Each flying customer: still a customer task in the list (else dropped), moved, falling, bouncing
+   until settled; then they wait where they landed. */
+static void custFly(void)
+{
+    int i;
+
+    for (i = 0; i < FLYER_MAX; i++) {
+        float *f = &custFlyers[i * 4], *at, *g;
+        unsigned char *t = ((unsigned char **)f)[0], *e;
+
+        if (!t)
+            continue;
+        for (e = EVENT_HEAD; e && e != t; e = *(unsigned char **)(e + 0x08))
+            ;
+        if (!e || *(unsigned int *)(e + 0x0C) != CUSTOMER_TASK) {
+            ((int *)f)[0] = 0;
+            continue;
+        }
+        at = (float *)(t + 0x1C + 4);
+        at[0] += f[1];
+        at[1] += f[2];
+        at[2] += f[3];
+        f[2] -= FLY_GRAVITY;
+        g = getCollision2D(at, 16.5f);
+        if (((int *)g)[7] == -1) {                      /* off the ground: dropped where it is */
+            ((int *)f)[0] = 0;
+            continue;
+        }
+        if (at[1] <= g[1] && f[2] < 0.0f) {
+            at[1] = g[1];
+            f[1] *= FLY_SKID;
+            f[3] *= FLY_SKID;
+            f[2] = -f[2] * FLY_BOUNCE;
+            if (f[2] < FLY_SETTLE)
+                ((int *)f)[0] = 0;
+        }
+    }
+}
+
+static int flying(unsigned char *q)
+{
+    int i;
+
+    for (i = 0; i < FLYER_MAX; i++)
+        if (((unsigned char **)FLYERS)[i * FLY] == q)
+            return 1;
+    return 0;
+}
+
+static void launch(unsigned char *q, float dx, float dz, float d)
+{
+    float *f = 0;
+    int i;
+
+    for (i = 0; i < FLYER_MAX; i++)
+        if (((int *)FLYERS)[i * FLY] == 0) {
+            f = &FLYERS[i * FLY];
+            break;
+        }
+    if (!f)
+        return;
+    ((unsigned char **)f)[0] = q;
+    f[1] = dx / d * d * FLY_PUSH;                          /* along the push, at about the car's speed */
+    f[2] = d * FLY_UP + FLY_LIFT;                          /* and up */
+    f[3] = dz / d * d * FLY_PUSH;
+    f[4] = ((float *)(q + 0x0C))[1];                   /* the ground they stood on: the tilt's zero (a lookup
+                                                           in flight can find a ledge at their own height) */
+}
+
+/* Each flyer: moved by its velocity, falling, bouncing off the ground until it has settled. */
+static void fly(void)
+{
+    int i;
+
+    for (i = 0; i < FLYER_MAX; i++) {
+        float *f = &FLYERS[i * FLY], *at, *g;
+        unsigned char *q = ((unsigned char **)f)[0];
+
+        if (!q)
+            continue;
+        if (*(int *)(q + 0x50) != 1) {                  /* gone or running: no longer ours */
+            ((int *)f)[0] = 0;
+            continue;
+        }
+        at = (float *)(q + 0x0C);
+        at[0] += f[1];
+        at[1] += f[2];
+        at[2] += f[3];
+        f[2] -= FLY_GRAVITY;
+        g = getCollision2D(at, 16.5f);
+        if (((int *)g)[7] == -1) {                      /* off the ground: dropped where it is */
+            ((int *)f)[0] = 0;
+            continue;
+        }
+        if (at[1] <= g[1] && f[2] < 0.0f) {
+            at[1] = g[1];
+            f[1] *= FLY_SKID;
+            f[3] *= FLY_SKID;
+            f[2] = -f[2] * FLY_BOUNCE;
+            if (f[2] < FLY_SETTLE)                          /* settled: standing again */
+                ((int *)f)[0] = 0;
+        }
+    }
+}
+
+/* pedDraw's humanDraw (one pool word, 0x0C0502FC; people within 300 of the camera, farther ones are
+   a far model): the matrix is at the person, in world space, and turned to their heading. A flyer is
+   found by that position, and tipped forward by its height: upright leaving and reaching the ground,
+   flat out (a plank) from FLY_FLAT up. */
+void modPedDraw(Motion *m, int character, int frame, int mode)
+{
+    float cur[3];
+    int i;
+
+    mtxGetTranslate(cur);
+    for (i = 0; i < FLYER_MAX; i++) {
+        float *f = &FLYERS[i * FLY], *at, h;
+        unsigned char *q = ((unsigned char **)f)[0];
+
+        if (!q)
+            continue;
+        at = (float *)(q + 0x0C);
+        if (vecDistance(at, cur) > 0.5f)
+            continue;
+        h = at[1] - f[4];
+        mtxRotZ(-(int)(h >= FLY_FLAT ? 16384.0f : h <= 0.0f ? 0.0f : h * (16384.0f / FLY_FLAT)));
+        break;
+    }
+    humanDraw(m, character, frame, mode);
+}
+
+/* Standing passers-by in a car's way: pushed out of its box, and launched if it came in fast. */
+static void pedsBumped(void)
+{
+    unsigned char *e, *q;
+    int n;
+
+    fly();
+    for (e = EVENT_HEAD; e; e = *(unsigned char **)(e + 0x08)) {
+        if (*(unsigned int *)(e + 0x0C) != CROWD_TASK)
+            continue;
+        q = *(unsigned char **)(e + 0x20);
+        for (n = *(unsigned short *)(e + 0x14); n > 0; n--, q += PERSON_SIZE) {
+            float *at = (float *)(q + 0x0C), was[3], d;
+
+            if (*(int *)(q + 0x50) == 2) {              /* running: about to leave the ground? pedDodgeCheck */
+                float *run = (float *)(q + 0x40), *dir = (float *)(q + 0x2C), next[3];   /* would end them; */
+                                                        /* the run ends here instead, as a finished one does */
+                next[0] = run[0] + dir[0] * 2.0f * *(float *)(q + 0x3C);
+                next[1] = run[1];
+                next[2] = run[2] + dir[2] * 2.0f * *(float *)(q + 0x3C);
+                if (((int *)getCollision2D(next, 16.5f))[7] == -1) {
+                    at[0] = run[0];
+                    at[1] = run[1];
+                    at[2] = run[2];
+                    *(int *)(q + 0x20) = 0;
+                    *(int *)(q + 0x50) = 1;
+                }
+                continue;
+            }
+            if (*(int *)(q + 0x50) != 1 || flying(q))
+                continue;
+            was[0] = at[0];
+            was[1] = at[1];
+            was[2] = at[2];
+            carsPush(at);
+            d = vecDistance(at, was);
+            if (d > FLY_LAUNCH)
+                launch(q, at[0] - was[0], at[2] - was[2], d);
+        }
+    }
+}
