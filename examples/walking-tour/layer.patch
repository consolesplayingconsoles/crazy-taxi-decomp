+/* Walking Tour settings: riding a tram (cable car). See README.md here for how they are split. */
+
+#define TRAM_TYPE       15              /* the cable cars' car type */
+#define TRAM_MAX        3.0f            /* top speed along the rail, units a frame (the game's own go 0.8-7.4) */
+#define TRAM_ACCEL      0.02f           /* gas (R, fully pressed) adds this a frame to the speed */
+#define TRAM_BRAKE      0.08f           /* brake (L, fully pressed) takes this off a frame */
+#define TRAM_DRAG       0.004f          /* what rolling loses a frame */
+#define TRAM_END        2               /* stops at this many points before a rail's last point (the game's own stop: the third from the end) */
+#define TRAM_REACH      30.0f           /* how close to a tram's side to board it (its box is wide: the cab's is 12) */
+#define TRAM_TURN_AHEAD 16              /* the turntable turns to the arrival rail when you are this many points from its end (the game's own) */
+
+/* The chase camera behind a tram: up and back from its centre (the cab's: 15, 60), and the look-at point
+   up and ahead (the cab's: 5, 17). Low and far enough back to see the tram's rear, not just its roof. */
+#define TRAM_CAM_UP     28.0f
+#define TRAM_CAM_BACK   (-140.0f)
+#define TRAM_AIM_UP     12.0f
+#define TRAM_AIM_AHEAD  40.0f
+#define TRAM_PITCH_EASE 4               /* the tilt follows the rail's slope by 1/this a frame */
+#define TRAM_GAP        110.0f          /* stays this far from the centre of another tram ahead on its rail (a tram is about 90 long) */
+#define TRAM_GATE       10              /* waits this many points before the turntable until it is turned to your rail */
+
+/* The turntable by hand (tram.c): at the end of a rail, stopped on the table, the stick swirled turns it. */
+#define TABLE_DEAD      28              /* the stick (-128..127) counts as moved from this far out, */
+#define TABLE_PUSH      70              /* and starts the turn from this far */
+#define TABLE_FOLLOW    0.05f           /* the table turns this share of the stick's swirl (angle units a frame) */
+#define TABLE_DRAG      0.96f           /* share of its spin kept a frame: the momentum (half gone in 17 frames) */
+#define TABLE_PICKUP    0.12f           /* how quickly it takes up a faster swirl (share of the gap a frame) */
+#define TABLE_MAX_SPIN  24.0f           /* at most this spin, angle units a frame (0x10000 = a turn): the game's own turn of the table (convergeRotLimit */
+                                        /* clamps its step to 24; a half turn takes about 23 seconds) */
+#define TABLE_SPIN_DIR  (-1)            /* a clockwise swirl turns it clockwise seen from above (-1: if it goes */
+                                        /* the other way, 1) */
+#define TABLE_CENTRE    0.92f           /* the tram settles on the table's centre by this share a frame */
+#define TABLE_FREE      0x0C00          /* the magnet works once the table has turned this far from where it was */
+#define TABLE_MAGNET    0x0700          /* a rail pulls within this angle (10 degrees)... */
+#define TABLE_MAGNET_SPEED 30.0f        /* ...when the spin is slower than this, */
+#define TABLE_PULL      0.5f            /* by this share of the angle left a frame (at most the spin above: the game's own step), */
+#define TABLE_DAMP      0.6f            /* slowing the spin too; */
+#define TABLE_LOCK      24              /* closer than this (and nearly still) it snaps (the game's own snap) and the tram may go */
+#define TABLE_LOCK_SPEED 8.0f
+#define TRAM_HALT       0.15f           /* what it slows by a frame when something ahead holds it (braking from the top speed takes about 20 frames) */
