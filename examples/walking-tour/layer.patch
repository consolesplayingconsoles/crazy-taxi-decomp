+/* Entry point: must stay the first function in this file (it is the start of the blob). */
+void modFrame(int hud)
+{
+    hudDraw(hud);
+    if (runFrames < INTRO)
+        runFrames++;
+    if ((PAD_PRESSED & BTN_ENTER) && runFrames >= INTRO && !(HUD_FLAGS & HUD_TIME_UP) && !tumble) {
+        float door[3];
+
+        if (!out)
+            stepOut();                                  /* not during the opening: no signal for it yet */
+        else {
+            doorPoint(door);
+            if (!carGone && groundDistance(POS, door) < DOOR_REACH)
+                stepIn();
+            else
+                carTakeOver();
+        }
+    }
+    if (out && tumble) {                                /* diving out: no control until he is up */
+        carLeftBehind();
+        dive();
+        touchAfter();
+        drawDriver();
+        followCam();
+    } else if (out) {
+        carLeftBehind();
+        if ((PAD_PRESSED & BTN_JUMP) && jumpY == 0.0f) {
+            jumpV = JUMP_SPEED;                         /* no jump motion in the game: a run carries on */
+            airFrame = WALK_FIRST;                      /* in the air; from standing he runs there */
+        }
+        if (hail || ((PAD_PRESSED & BTN_HAIL) && jumpY == 0.0f)) {
+            gait = 0;                                   /* standing still to hail: one press, the taxi */
+            if (hail++ == 0)                            /* comes at once and the hand stays up a while */
+                carHail();
+            if (hail == HAIL_TIME)
+                hail = 0;
+        } else {
+            hail = 0;
+            walk();
+        }
+        jumpY += jumpV;
+        jumpV -= GRAVITY;
+        if (jumpY <= 0.0f) {
+            jumpY = 0.0f;
+            jumpV = 0.0f;
+        }
+        touchAfter();                                   /* set objects fly, people jump aside */
+        drawDriver();
+        followCam();
+    }
+}
