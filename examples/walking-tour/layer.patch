+def mod_sources():
+    """New code that is no game function (a mod's own files): mod-sources.txt in the repo, one src/ pattern per line (# comments).
+    Each match is copied into build/cbuild/src/ whole, its comments blanked (their addresses are prose, not code; the line numbers
+    stay), so it is compiled and placed like the game's files and its numbers are rewritten like theirs, headers included."""
+    if not os.path.exists('mod-sources.txt'):
+        return []
+    out = []
+    for pat in [l.split('#')[0].strip() for l in open('mod-sources.txt')]:
+        for p in sorted(glob.glob('src/' + pat)) if pat else []:
+            dst = '%s/%s' % (OUT, p)
+            os.makedirs(os.path.dirname(dst), exist_ok=True)
+            t = open(p, errors='replace').read()
+            t = re.sub(r'/\*.*?\*/', lambda m: re.sub(r'[^\n]', ' ', m.group(0)), t, flags=re.S)
+            open(dst, 'w').write(t)
+            out.append(p)
+    return out
+
