+
+/* Pushes a point on foot out of every person in the crowds (a crowd's event: +0x14 its people, +0x20
+   their records; a person's state at +0x50 is 1 standing or 2 dodging while there). */
+static void pedsPush(float *p)
+{
+    unsigned char *e, *q;
+    int n;
+
+    for (e = EVENT_HEAD; e; e = *(unsigned char **)(e + 0x08)) {
+        if (*(unsigned int *)(e + 0x0C) != CROWD_TASK)
+            continue;
+        q = *(unsigned char **)(e + 0x20);
+        for (n = *(unsigned short *)(e + 0x14); n > 0; n--, q += PERSON_SIZE) {
+            float *at = (float *)(q + 0x0C), len;
+
+            if (*(int *)(q + 0x50) < 1)
+                continue;
+            len = vecDistance(p, at);
+            if (len < PED_REACH) {
+                len = PED_REACH / (len + 0.01f);
+                p[0] = at[0] + (p[0] - at[0]) * len;
+                p[2] = at[2] + (p[2] - at[2]) * len;
+            }
+        }
+    }
+    for (e = EVENT_HEAD; e; e = *(unsigned char **)(e + 0x08)) {   /* and customers (kyakuTaskExec's */
+        float *at = (float *)(e + 0x1C + 4), len;                   /* tasks: the passenger at +0x1C) */
+
+        if (*(unsigned int *)(e + 0x0C) != CUSTOMER_TASK || *(int *)(e + 0x1C + 0x20) > 1)
+            continue;                                   /* only waiting (states 0, 1): not riding */
+        len = vecDistance(p, at);
+        if (len < PED_REACH) {
+            len = PED_REACH / (len + 0.01f);
+            p[0] = at[0] + (p[0] - at[0]) * len;
+            p[2] = at[2] + (p[2] - at[2]) * len;
+        }
+    }
+}
+
+/* Standing still: what pushes him when he walks pushes him here too, walls, cars and people. */
+static void standPush(void)
+{
+    float stand[3];
+
+    stand[0] = POS[0];
+    stand[1] = POS[1];
+    stand[2] = POS[2];
+    checkColliWall(stand, BODY);
+    carsPush(stand);
+    pedsPush(stand);
+    if (stand[0] == POS[0] && stand[2] == POS[2])
+        return;                                         /* nothing pushed him: he is not placed again (not every frame */
+    if (((int *)getCollision2D(stand, 5.0f))[7] != -1)  /* he stands still) */
+        psgSetPosPtr(ped, stand);
+}
+
+/* Out of the car by the door, at any speed: Crazy Taxi's Jump Left (JUMP_OUT), moving as far as its
+   root does, plus what is left of the car's speed (DIVE_SLIDE), with walls, cars and people in the way
+   as when walking. */
+static void dive(void)
+{
+    float next[3], step[3], from = outKey, last = (float)(JUMP_OUT->frames - 1);
+
+    outKey += JUMP_OUT_RATE;
+    if (outKey > last)
+        outKey = last;
+    step[0] = rootX(JUMP_OUT, outKey) - rootX(JUMP_OUT, from);
+    step[1] = step[2] = 0.0f;
+    fromCar(POS, yaw, step, next);
+    next[0] += tumbleV[0];
+    next[2] += tumbleV[1];
+    tumbleV[0] *= DIVE_FRICTION;
+    tumbleV[1] *= DIVE_FRICTION;
+    checkColliWall(next, BODY);
+    carsPush(next);
+    pedsPush(next);
+    if (((int *)getCollision2D(next, 5.0f))[7] != -1)
+        psgSetPosPtr(ped, next);
+    if (outKey >= last)
+        tumble = 0;
+}
+
+
+/* Camera-relative controls: the stick points where to go on screen; the driver turns toward it
+   and walks (B held: runs). Root motion: they move exactly as far as the animation's root does,
+   so the feet stay planted at any speed. Letting go plays the clip's halt. The ground keeps them
+   on it. */
+static void walk(void)
+{
+    int sx = (PAD_STICK_X >> 8) - 128;
+    int sy = (PAD_STICK_Y >> 8) - 128;                  /* up < 0 */
+    float cam[3], fwd[3], f[3], f2[3], want[3], len, cross, dot, fr, dx = 0.0f, next[3], step[3];
+    int turn, moving = (sx > STICK_DEAD || sx < -STICK_DEAD || sy > STICK_DEAD || sy < -STICK_DEAD);
+
+    if (jumpY > 0.0f || jumpV > 0.0f)
+        moving = (gait == 1);                           /* in the air: no steering, the take-off's run goes on */
+    else if (moving) {
+        cam[0] = CAM_EYE[0];                            /* camera forward, on the ground plane */
+        cam[1] = POS[1];
+        cam[2] = CAM_EYE[2];
+        len = vecDistance(POS, cam);
+        if (len < 1.0f)
+            return;
+        nlSubVector3op(fwd, POS, cam);
+        nlScaleVector(fwd, fwd, 1.0f / len);
+        want[0] = fwd[0] * (float)(-sy) + (-fwd[2]) * (float)sx;   /* forward and right */
+        want[1] = 0.0f;
+        want[2] = fwd[2] * (float)(-sy) + fwd[0] * (float)sx;
+        facing(yaw, f);
+        facing(yaw + 0x400, f2);                        /* which way a bigger heading turns */
+        cross = f[2] * want[0] - f[0] * want[2];
+        dot = nlInnerProduct(f, want);
+        turn = (short)arcTan2(cross, dot);
+        if (f[2] * f2[0] - f[0] * f2[2] < 0.0f)
+            turn = -turn;
+        yaw += turn >> (SPRINTING ? RUN_TURN_SHIFT : TURN_SHIFT);
+        rate = (SPRINTING ? RUN_RATE : WALK_RATE);
+        stride = (SPRINTING ? RUN_STRIDE : WALK_STRIDE);
+        if (gait != 1 || walkFrame < WALK_FIRST || walkFrame >= WALK_LAST)
+            walkFrame = WALK_FIRST;
+        gait = 1;
+    }
+    if (moving) {
+        fr = walkFrame + rate;
+        if (fr >= WALK_LAST) {
+            dx = rootX(WALK, WALK_LAST) - rootX(WALK, walkFrame);
+            fr -= WALK_LAST - WALK_FIRST;
+            dx += rootX(WALK, fr) - rootX(WALK, WALK_FIRST);
+        } else
+            dx = rootX(WALK, fr) - rootX(WALK, walkFrame);
+        walkFrame = fr;
+    } else if (gait == 1) {
+        gait = 2;                                       /* let go: halt from the stride's end */
+        walkFrame = WALK_LAST;
+    } else if (gait == 2) {
+        fr = walkFrame + HALT_RATE;
+        if (fr >= HALT_LAST) {
+            gait = 0;
+        } else {
+            dx = rootX(WALK, fr) - rootX(WALK, walkFrame);
+            walkFrame = fr;
+        }
+    }
+    if (dx != 0.0f) {
+        step[0] = dx * stride;
+        step[1] = step[2] = 0.0f;
+        fromCar(POS, yaw, step, next);
+        checkColliWall(next, BODY);                     /* walls and poles push him back out */
+        carsPush(next);                                 /* and so do cars */
+        pedsPush(next);                                 /* and people */
+        if (((int *)getCollision2D(next, 5.0f))[7] != -1)   /* no ground there (past the shore: the */
+            psgSetPosPtr(ped, next);                    /* snap left him in the air over the sea) */
+    } else
+        standPush();                                    /* standing still: cars and people push him as when he walks */
+}
+
+
+
+/* The chosen driver: walking, running or halting (the jog clip, played in place: mode 1, as
+   moving customers do; walk() moves them) or standing (a customer waiting idle, facing the same
+   way). */
+static void drawDriver(void)
+{
+    int d = DRIVER;
+    DriverEntry *e;
+
+    if (d < 0 || d > 3)
+        return;
+    e = &DRIVERS[d];
+    mtxPush(0);
+    mtxTranslate(POS);
+    mtxTranslateXYZ(0.0f, jumpY, 0.0f);
+    mtxRotY(yaw);
+    if (gait == 1 && walkFrame > WALK_LAST - SEAM) {   /* ease into the stride's first pose */
+        humanDrawMix(WALK, (int)walkFrame, WALK, (int)(walkFrame - (WALK_LAST - WALK_FIRST)),
+                     (walkFrame - (WALK_LAST - SEAM)) / SEAM, e->character, 1);
+    } else if (jumpY > 0.0f && !gait) {                /* jumped from standing: running in the air */
+        airFrame += AIR_RATE;
+        if (airFrame >= WALK_LAST)
+            airFrame -= WALK_LAST - WALK_FIRST;
+        humanDraw(WALK, e->character, (int)airFrame, 1);
+    } else if (gait) {
+        if (gait == 2)                                  /* the halt turns him to the standing pose's */
+            mtxRotY((int)(STAND_TURN * (walkFrame - WALK_LAST) / (HALT_LAST - WALK_LAST)));   /* facing: undone */
+        humanDraw(WALK, e->character, (int)walkFrame, 1);
+    } else if (tumble) {
+        humanDraw(JUMP_OUT, e->character, (int)outKey, 1);   /* the jump out of the car */
+    } else if (hail) {
+        mtxRotY(STAND_TURN);
+        humanDraw(HAIL, e->character, hail < HAIL->frames ? hail : HAIL->frames - 1, 0);
+    } else {
+        mtxRotY(STAND_TURN);
+        humanDraw(WALK, e->character, 0, 1);            /* standing, before setting off (= where halts end) */
+    }
+    mtxPop(1);
+    drawFare();
+}
+
+/* A fare riding with him, on foot: jogs along FARE_BEHIND behind him, in their own character, his
+   gait (the seated passenger is hidden: modPassengerDraw). */
+static void drawFare(void)
+{
+    unsigned char *t = ridingTask();
+    float f[3], to[3], *g;
+
+    if (!t) {
+        fare[0] = POS[0];                               /* none: the next starts where he is */
+        fare[1] = POS[1];
+        fare[2] = POS[2];
+        return;
+    }
+    facing(yaw, f);
+    to[0] = POS[0] - f[0] * FARE_BEHIND;
+    to[2] = POS[2] - f[2] * FARE_BEHIND;
+    fare[0] += (to[0] - fare[0]) * FARE_CATCH;
+    fare[2] += (to[2] - fare[2]) * FARE_CATCH;
+    fare[1] = POS[1];
+    g = getCollision2D(fare, 5.0f);
+    if (((int *)g)[7] != -1)
+        fare[1] = g[1];
+    mtxPush(0);
+    mtxTranslate(fare);
+    mtxRotY(yaw);
+    humanDraw(WALK, *(int *)(t + 0x1C), gait ? (int)walkFrame : 0, 1);
+    mtxPop(1);
+}
+
+/* The ground height under a point beside him (his height, then a probe from above), or -1e9: none. */
+static float groundAt(float *p)
+{
+    float probe[3], *g;
+
+    probe[0] = p[0];
+    probe[1] = POS[1] + SLOPE_PROBE;
+    probe[2] = p[2];
+    g = getCollision2D(probe, 5.0f);
+    return ((int *)g)[7] != -1 ? g[1] : -1.0e9f;
+}
+
+/* GTA-style follow with the game's own chase-camera mechanics: the eye keeps its distance from the
+   driver, from wherever it already is (dragged along, not spun), but sits along the slope under him
+   (up the slope it drops behind him, down it rises) and the look-at tilts with it, as the game's
+   chase camera places both in the car's yaw and pitch axes. Both points then ease to their goals
+   (camSetEye/camSetTarget mode 2, with the game's pull and keep) instead of snapping there. */
+static void followCam(void)
+{
+    float cam[3], eye[3], target[3], len, f[3], d[3], ahead[3], behind[3], hA, hB, slope = 0.0f;
+    int snap = 0;
+
+    cam[0] = CAM_EYE[0];
+    cam[1] = POS[1];
+    cam[2] = CAM_EYE[2];
+    len = vecDistance(POS, cam);
+    if (len < 1.0f) {                                   /* right on top: start behind them */
+        snap = 1;
+        facing(yaw, f);
+        d[0] = f[0];
+        d[1] = 0.0f;
+        d[2] = f[2];
+    } else {
+        nlSubVector3op(d, POS, cam);                    /* the way the camera looks, on the ground plane */
+        nlScaleVector(d, d, 1.0f / len);
+    }
+    ahead[0] = POS[0] + d[0] * SLOPE_SPAN;
+    ahead[2] = POS[2] + d[2] * SLOPE_SPAN;
+    behind[0] = POS[0] - d[0] * SLOPE_SPAN;
+    behind[2] = POS[2] - d[2] * SLOPE_SPAN;
+    hA = groundAt(ahead);
+    hB = groundAt(behind);
+    if (hA > -1.0e8f && hB > -1.0e8f) {                  /* rise per unit along his way: + uphill */
+        slope = (hA - hB) / (2.0f * SLOPE_SPAN);
+        if (slope > SLOPE_MAX)
+            slope = SLOPE_MAX;
+        if (slope < -SLOPE_MAX)
+            slope = -SLOPE_MAX;
+    }
+    eye[0] = POS[0] - d[0] * CAM_DIST;
+    eye[1] = POS[1] + CAM_HEIGHT - slope * CAM_DIST;
+    eye[2] = POS[2] - d[2] * CAM_DIST;
+    target[0] = POS[0] + head[0];
+    target[1] = POS[1] + head[1] + slope * CAM_LOOK;
+    target[2] = POS[2] + head[2];
+    camSetRatio(CAM_PULL, CAM_KEEP);
+    camSetTargetRatio(TARGET_PULL, TARGET_KEEP);
+    camSetEye(eye, snap ? 0 : 2);
+    camSetTarget(target, snap ? 1 : 2);
+}
