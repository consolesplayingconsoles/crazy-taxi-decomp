+/* The root's x (the walk's forward axis is -x) at a fractional frame of a motion. */
+static float rootX(Motion *m, float f)
+{
+    float *d = (float *)m->data;
+    int i = (int)f;
+    float t = f - (float)i;
+
+    return d[i * 99] + (d[(i + 1) * 99] - d[i * 99]) * t;
+}
+
+/* The driver's facing in world space for a heading: the motions' forward is local -x. */
+static void facing(int h, float *f)
+{
+    f[0] = -nlCos(h);
+    f[1] = 0.0f;
+    f[2] = nlSin(h);
+}
