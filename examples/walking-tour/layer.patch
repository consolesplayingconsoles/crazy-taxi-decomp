+static void stepOut(void)
+{
+    float door[3], *ground;
+
+    doorPoint(door);
+    ground = getCollision2D(door, 5.0f);                /* Psg_SetPosPtr's own look-up, which moves him */
+    if (((int *)ground)[7] == -1 || door[1] - ground[1] > DOOR_DROP_MAX)   /* only to ground near below: no */
+        return;                                         /* getting out in the air (or over water) */
+    psgSetPosPtr(ped, door);
+    carRestSample(POS[1]);
+    yaw = TAXI_YAW;
+    savedMode = VR_MODE;
+    savedSub = CAM_SUBMODE;
+    VR_MODE = 9;
+    CAM_SUBMODE = 1;
+    gait = 0;
+    jumpY = 0.0f;
+    jumpV = 0.0f;
+    tumble = 0;
+    tumbleV[0] = ((float *)(TAXI + 0xFC))[0];           /* the car's velocity: diving out of a fast one */
+    tumbleV[1] = ((float *)(TAXI + 0xFC))[2];
+    if (look == TRAM_TYPE) {                            /* a tram left behind stops dead on its rail */
+        int i;
+
+        for (i = 0; i < 3; i++)
+            ((float *)(TAXI + 0xFC))[i] = ((float *)(TAXI + 0x108))[i] = 0.0f;
+        *(float *)(TAXI + 0x15C) = 0.0f;
+    }
+    tumble = 1;                                         /* out by the door, at any speed: Crazy Taxi's Jump Left */
+    outKey = JUMP_OUT_FIRST;
+    tumbleV[0] *= DIVE_SLIDE;
+    tumbleV[1] *= DIVE_SLIDE;
+    {
+        float d[3];
+
+        d[0] = door[0] - TAXI_POS[0];                   /* the jump goes from the cab to its door: the */
+        d[2] = door[2] - TAXI_POS[2];                   /* clip travels along his facing (local -x) */
+        if (d[0] != 0.0f || d[2] != 0.0f)
+            yaw = (short)arcTan2(d[2], -d[0]);
+    }
+    out = 1;
+}
