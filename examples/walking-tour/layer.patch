+    unsigned char *r;
+    int i;
+
+    inCar = out ? 0 : inCar < BOARD_WAIT ? inCar + 1 : inCar;
+    BOARD_RANGE = inCar < BOARD_WAIT ? 0.0f : 500.0f;   /* the test is range > distance: 0 never passes; on */
+                                                        /* foot, and a moment after getting in (a fare by a */
+                                                        /* taken car boarded before it had settled) */
+    pedsBumped();
