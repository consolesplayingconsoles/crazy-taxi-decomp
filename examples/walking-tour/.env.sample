# Folder holding your disc's .gdi (and its track files)
ORIGINAL_GDI_DIR="/path/to/your disc folder"
# A Python 3
PYTHON="/path/to/python3"
# Your Katana SDK
SDK_PATH="/path/to/katana-sdk"
# 1: the game presses Start and A by itself through the menus, straight into an Arcade run (0: you go through them)
QUICK_START=0
